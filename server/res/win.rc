/**
 * https://learn.microsoft.com/zh-cn/windows/win32/menurc/versioninfo-resource
 */
#pragma code_page(65001)

#include <verrsrc.h>

IDI_ICON1 ICON "logo.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#if CAIWEI_DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName",      "acgist"
            VALUE "FileDescription",  "采薇"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "采薇"
            VALUE "LegalCopyright",   "Copyright © 2026 acgist.com. All Rights Reserved."
            VALUE "LegalTrademarks",  "caiwei"
            VALUE "OriginalFilename", "caiwei-server.exe"
            VALUE "ProductName",      "采薇"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 0x04B0
    END
END
